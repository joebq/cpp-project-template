    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC ASan Build",
      "configurePreset": "msvc-asan"
    }
  ],

  "testPresets": [
    {
      "name": "clang-modules",
      "displayName": "Tests (Clang Modules)",
      "configurePreset": "clang-modules",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Tests (Clang Debug)",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
