{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// --- clangd: IntelliSense, diagnostics, formatting, clang-tidy ---
		"clangd.arguments": [
			"--background-index",
			"--clang-tidy",
			"--header-insertion=iwyu",
			"--completion-style=detailed",
			"--function-arg-placeholders=false",
			"--pch-storage=memory",
			// Lets clangd ask the real compiler (GCC/Clang) for its system include paths
			"--query-driver=/usr/bin/*,/usr/local/bin/*,/opt/homebrew/bin/*,/opt/homebrew/opt/llvm/bin/*"
		],
		"clangd.checkUpdates": false,
		"editor.inlayHints.enabled": "on",
		// --- CMake Tools: keep the active preset's compile_commands.json at the repo root for clangd ---
		"cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
		"cmake.useCMakePresets": "always",
		// --- Microsoft C/C++ (cpptools): debugging only, language features off to avoid clangd conflicts ---
		"C_Cpp.intelliSenseEngine": "disabled",
		"C_Cpp.autocomplete": "disabled",
		"C_Cpp.errorSquiggles": "disabled",
		"C_Cpp.formatting": "disabled",
		"C_Cpp.enhancedColorization": "disabled",
		"C_Cpp.codeFolding": "disabled",
		"C_Cpp.codeAnalysis.runAutomatically": false,
		"C_Cpp.codeAnalysis.clangTidy.enabled": false,
		"C_Cpp.autoAddFileAssociations": false,
		"[c]": {
			"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
		},
		"[cpp]": {
			"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
		}
	},
	"extensions": {
		"recommendations": [
			"llvm-vs-code-extensions.vscode-clangd",
			"ms-vscode.cpptools",
			"ms-vscode.cmake-tools"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug CMake target (cpptools)",
				"type": "cppdbg",
				"request": "launch",
				"program": "${command:cmake.launchTargetPath}",
				"args": [],
				"cwd": "${workspaceFolder}",
				"stopAtEntry": false,
				"osx": {
					"MIMode": "lldb"
				},
				"linux": {
					"MIMode": "gdb",
					"setupCommands": [
						{
							"description": "Enable pretty-printing for gdb",
							"text": "-enable-pretty-printing",
							"ignoreFailures": true
						}
					]
				}
			}
		]
	}
}